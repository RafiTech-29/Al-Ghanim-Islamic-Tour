rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data operasional jamaah, log pertanyaan, kemitraan, paket CMS, dan banner promo
    match /jamaah/{docId} {
      allow read, write: if true;
    }
    match /inquiries/{docId} {
      allow read, write: if true;
    }
    match /partners_registrations/{docId} {
      allow read, write: if true;
    }
    match /packages/{docId} {
      allow read, write: if true;
    }
    match /promo_banners/{docId} {
      allow read, write: if true;
    }
    match /testimonials/{docId} {
      allow read, write: if true;
    }
    match /gallery/{docId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
